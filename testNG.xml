<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--        parallel="tests" thread-count="3"-->
<suite name="Suite" >
    <listeners>
        <listener class-name="org.example.saucedemo.listeners.TestListener"/>
    </listeners>
    <test name="BasicTest-Go to url">
        <classes>
            <class name="org.example.Main"/>
        </classes>
    </test>
    <test name="LoginTest- without POM " parallel="classes">
        <classes>
            <class name="org.example.login.ValidLogin"/>
            <class name="org.example.login.InvalidLogin"/>
        </classes>
    </test>
    <test name="checkout - without POM">
        <classes>
            <class name="org.example.checkout.CheckOutBasic"/>
        </classes>
    </test>
    <test name="SauceDemoE2ECheckout - POM ">
        <classes>
            <class name="org.example.saucedemo.CheckOutTest"/>
        </classes>
    </test>
</suite>